PORT=8080

# Etherscan API V2 (multichain). Get a free key at https://etherscan.io/myapikey
# Free tier covers txlist / getsourcecode / eth_getCode.
# The nametag (address label) module requires Etherscan Pro Plus; when your key
# lacks it the backend logs once and falls back to the built-in label registry.
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ETHERSCAN_API_KEY=
ETHERSCAN_CHAIN_ID=1
ETHERSCAN_RATE_LIMIT_PER_SEC=4
ETHERSCAN_MAX_RETRIES=3
ETHERSCAN_TX_PAGE_SIZE=1000
ETHERSCAN_TX_MAX_PAGES=1
# desc = newest first (what you want when tracing where funds went); asc = oldest first
ETHERSCAN_TX_SORT=desc

# Trace traversal limits
TRACE_MAX_HOPS=4
TRACE_MAX_FANOUT=10
TRACE_MAX_NODES=60
TRACE_PREFER_CACHED=false

# Label resolution
LABELS_ENRICH_FROM_CHAIN=true
LABELS_CACHE_TTL_HOURS=168

# GraphQL API exposed by this backend
GRAPHQL_PATH=/graphql
GRAPHQL_GRAPHIQL=true

DB_PATH=./data/cryptofraud.sqlite

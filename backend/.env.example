PORT=8080

# ── Ethereum / EVM (Etherscan API V2) ─────────────────────────────────────────
# Get a free key at https://etherscan.io/myapikey
# Free tier covers: txlist, tokentx (ERC-20), getsourcecode, eth_getCode
# nametag (address label module) requires Etherscan Pro Plus; gracefully degraded on free keys.
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ETHERSCAN_API_KEY=
ETHERSCAN_CHAIN_ID=1
# Free tier answers sustained calling with a bogus "Invalid API Key" — 1/sec survives.
ETHERSCAN_RATE_LIMIT_PER_SEC=1
ETHERSCAN_MAX_RETRIES=3
ETHERSCAN_TX_PAGE_SIZE=1000
ETHERSCAN_TX_MAX_PAGES=1
# desc = newest first (what you want when tracing where funds went); asc = oldest first
ETHERSCAN_TX_SORT=desc
ETHERSCAN_TIMEOUT_MS=20000

# ── Tron (TronGrid API) ───────────────────────────────────────────────────────
# No key required for basic use (free public tier ~15 req/sec).
# Get a free API key at https://www.trongrid.io/ for higher limits.
TRONGRID_BASE_URL=https://api.trongrid.io
TRONGRID_API_KEY=
TRONGRID_RATE_LIMIT_PER_SEC=10
TRONGRID_MAX_RETRIES=3
TRONGRID_TX_LIMIT=200
TRONGRID_TIMEOUT_MS=20000

# ── Trace traversal limits ────────────────────────────────────────────────────
TRACE_MAX_HOPS=4
TRACE_MAX_FANOUT=10
TRACE_MAX_NODES=60
TRACE_PREFER_CACHED=false

# ── Label resolution ──────────────────────────────────────────────────────────
LABELS_ENRICH_FROM_CHAIN=true
LABELS_CACHE_TTL_HOURS=168

# ── GraphQL API ───────────────────────────────────────────────────────────────
GRAPHQL_PATH=/graphql
GRAPHQL_GRAPHIQL=true

# ── ML service (Python FastAPI: backend/ml-service/main.py) ───────────────────
# Base URL of the ML service covering XGBoost+SHAP, Isolation Forest,
# label propagation/clustering and layering rules. Empty = disabled.
# Run locally with: uvicorn main:app --reload --port 8000 (from backend/ml-service/)
ML_URL=
ML_TIMEOUT_MS=15000

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./data/cryptofraud.sqlite

